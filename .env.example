# ===================================================
# DigitalHelper Environment Configuration Template
# Copy to .env or set in your environment
# NEVER commit real credentials to version control
# ===================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Settings (when running with --spring.profiles.active=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=digitalhelper_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# JWT Security Key (At least 256 bits HMAC-SHA)
JWT_SECRET=DigitalHelperSecretKeyMustBeAtLeast256BitsLongForSecureHmacShaSignature2026
JWT_EXPIRATION_MS=86400000

# AI Provider Configuration
# Set AI_PROVIDER to 'gemini', 'openai', or 'mock'
AI_PROVIDER=mock
AI_API_KEY=your_llm_api_key_here
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
